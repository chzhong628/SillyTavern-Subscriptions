diff --git a/public/scripts/extensions/stable-diffusion/providers.js b/public/scripts/extensions/stable-diffusion/providers.js
new file mode 100644
--- /dev/null
+++ b/public/scripts/extensions/stable-diffusion/providers.js
@@ -0,0 +1,32 @@
+/** Third-party image sources share the native prompt, upload and chat pipeline. */
+const providers = new Map();
+const listeners = new Set();
+
+export function getImageGenerationProvider(id) { return providers.get(id); }
+export function listImageGenerationProviders() { return [...providers.values()]; }
+export function onImageGenerationProvidersChanged(callback) {
+    listeners.add(callback);
+    return () => listeners.delete(callback);
+}
+
+/**
+ * Register a namespaced source. generate returns {data: base64, format: string}.
+ * The returned cleanup only removes this registration, never a replacement.
+ */
+export function registerImageGenerationProvider(provider) {
+    if (!provider || !/^[a-z0-9_-]+:[a-z0-9_-]+$/.test(provider.id)
+        || typeof provider.label !== 'string' || typeof provider.generate !== 'function'
+        || typeof provider.isAvailable !== 'function' || !Array.isArray(provider.models)
+        || !provider.models.length || provider.models.some(m => typeof m.value !== 'string' || typeof m.text !== 'string')) {
+        throw new Error('Invalid image generation provider');
+    }
+    if (providers.has(provider.id)) throw new Error(`Image source ${provider.id} is already registered`);
+    const registered = Object.freeze({ ...provider, models: provider.models.map(m => Object.freeze({ ...m })) });
+    providers.set(provider.id, registered);
+    for (const callback of listeners) callback();
+    return () => {
+        if (providers.get(provider.id) !== registered) return;
+        providers.delete(provider.id);
+        for (const callback of listeners) callback();
+    };
+}
